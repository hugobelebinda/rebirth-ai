# Settings Rebirth reads from the environment. It does not load this file itself: export what you
# change (e.g. in ~/.bashrc), or copy it to .env and run `set -a; . ./.env; set +a`. Never commit .env.

# Ollama (AMD RX 7800 XT — ROCm/Vulkan, not CUDA)
# See docs/OLLAMA_AMD_GPU.md
OLLAMA_HOST=http://127.0.0.1:11434
# Default: Q6_K of Qwen2.5-Coder 14B (~12GB) — higher fidelity than Q4, still fully on 16GB VRAM
OLLAMA_MODEL=qwen2.5-coder:14b-instruct-q6_K
# Fallback (faster, more VRAM headroom): qwen2.5-coder:14b
# Stretch (spills off 16GB): qwen2.5-coder:32b

# Sandbox
REBIRTH_SANDBOX_IMAGE=rebirth-ai/js-ts-sandbox:latest
# Test time limit in seconds for every language (default per language: 120 JS/TS + Python, 180 Go,
# 300 the others). Sandbox limits: docs/SECURITY.md
# REBIRTH_SANDBOX_TIMEOUT_SEC=300
# REBIRTH_SANDBOX_MEMORY=4g
# REBIRTH_SANDBOX_PIDS=1024

# RAG
# Code search embedder (sentence-transformers). Override with REBIRTH_EMBEDDER=hash for tests.
REBIRTH_EMBEDDING_MODEL=flax-sentence-embeddings/st-codesearch-distilroberta-base
REBIRTH_VECTOR_DB_PATH=data/embeddings.db
REBIRTH_CLASSIFIER_DIR=data/models/error_classifier

# Agent loop
REBIRTH_MAX_ITERATIONS=5
# Generator: ollama (default) | peft
# REBIRTH_GENERATOR=ollama
# PEFT defaults to 7B adapter when present; override if needed:
# REBIRTH_PEFT_BASE=Qwen/Qwen2.5-Coder-7B-Instruct
# REBIRTH_PEFT_ADAPTER=data/models/lora_js_ts_7b/adapter
# Fallback 0.5B: Qwen/Qwen2.5-Coder-0.5B-Instruct + data/models/lora_js_ts/adapter
# Keep display stable on the 7800 XT: REBIRTH_PEFT_DEVICE=cpu
# REBIRTH_PEFT_DEVICE=auto

# GitHub (Phase 5) — prefer `gh auth` / env, never commit tokens
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
