# Copy to .env and adjust. Never commit .env.

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Sandbox
REBIRTH_SANDBOX_IMAGE=rebirth-ai/js-ts-sandbox:latest
REBIRTH_SANDBOX_TIMEOUT_SEC=120

# RAG
REBIRTH_EMBEDDING_MODEL=microsoft/unixcoder-base
REBIRTH_VECTOR_DB_PATH=data/embeddings.db

# Agent loop
REBIRTH_MAX_ITERATIONS=5

# GitHub (Phase 5) — prefer `gh auth` / env, never commit tokens
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
