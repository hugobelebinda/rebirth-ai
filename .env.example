# Settings Rebirth reads from the environment. Every one has a default; the lines below show it.
# Rebirth does not load this file itself: export what you change (e.g. in ~/.bashrc), or copy it to .env,
# uncomment what you change and run `set -a; . ./.env; set +a`. Never commit .env.

# --- Models (Ollama) ------------------------------------------------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434
# Which model writes drafts: auto (the installed Rebirth models, configs/routing.yaml) | ollama (OLLAMA_MODEL) | peft
# REBIRTH_GENERATOR=auto
# The plain model for --backend ollama, and the first choice for the fallback
# OLLAMA_MODEL=qwen2.5-coder:14b-instruct-q6_K
# The model `migrate --to` uses
# REBIRTH_XLANG_MODEL=rebirth-xlang:14b

# --- Fallback: a 14B retries files the 7B left unchanged -------------------------------------------------
# REBIRTH_FALLBACK=1                  # 0 turns it off (same as --no-fallback)
# REBIRTH_FALLBACK_MODEL=             # default: OLLAMA_MODEL if installed, else rebirth-xlang:14b
# REBIRTH_FALLBACK_TRIES=2

# --- The loop -------------------------------------------------------------------------------------------
# REBIRTH_MAX_ITERATIONS=5            # tries per file
# REBIRTH_KEEP_COMMENTS=1             # 0 lets a passing draft drop the file's comments
# REBIRTH_MAX_FILE_BYTES=204800       # larger files are skipped

# --- Sandbox (docs/SECURITY.md) ---------------------------------------------------------------------------
# REBIRTH_SANDBOX_TIMEOUT_SEC=        # default per language: 120 JS/TS and Python, 180 Go, 300 the others
# REBIRTH_SANDBOX_MEMORY=4g
# REBIRTH_SANDBOX_PIDS=1024
# Images: REBIRTH_SANDBOX_IMAGE (JS/TS), REBIRTH_<PYTHON|GO|JAVA|CSHARP|RUST|CPP|SWIFT>_SANDBOX_IMAGE
# REBIRTH_SANDBOX_IMAGE=rebirth-ai/js-ts-sandbox:latest
# Lets the sandbox install packages that only the model's draft asks for. Only on a machine you can throw away.
# REBIRTH_ALLOW_UNDECLARED_PACKAGES=0

# --- Code search (rebirth index) -------------------------------------------------------------------------------
# REBIRTH_EMBEDDING_MODEL=flax-sentence-embeddings/st-codesearch-distilroberta-base
# REBIRTH_EMBEDDER=                   # hash = no embedding model (tests, low-memory machines)
# REBIRTH_VECTOR_DB_PATH=             # default: data/embeddings.db in the Rebirth folder

# --- Local files (default: data/ in the Rebirth folder, never the folder you run Rebirth from) ------------------
# REBIRTH_RUNS_DIR=                   # run logs (rebirth dashboard, rebirth report)

# --- Maintainers: training, serving, tracking -----------------------------------------------------------------
# REBIRTH_ROUTING=configs/routing.yaml
# REBIRTH_TRANSLATOR=auto             # auto | ollama | peft: which model `--to` uses
# REBIRTH_OLLAMA_NUM_CTX=             # context window for Ollama requests
# REBIRTH_PEFT_BASE=Qwen/Qwen2.5-Coder-7B-Instruct
# REBIRTH_PEFT_ADAPTER=data/models/lora_js_ts_7b/adapter
# REBIRTH_PEFT_DEVICE=auto            # cpu keeps the display stable on a 16 GB AMD card
# REBIRTH_TRACKING=1                  # 0 = no MLflow tracking
