# Per-language LoRA metadata (adapters themselves stay ignored)
!data/models/lora_*_7b/
!data/models/lora_*_7b/*.json
# Phase 14: adapters are DVC-tracked — commit their pointer + per-dir .gitignore
!data/models/lora_*_7b/*.dvc
!data/models/lora_*_7b/.gitignore
# Phase 15: 14B adapters — same rules
!data/models/lora_*_14b/
!data/models/lora_*_14b/*.json
!data/models/lora_*_14b/*.dvc
!data/models/lora_*_14b/.gitignore

